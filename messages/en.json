                "cards": {
                    "archiviste": {
                        "name": "The Archivist",
                        "up": "Everything will be written down. You become the witness of what happens, and nothing can be forgotten.",
                        "kwUp": "witness. memory. too late to ignore.",
                        "rev": "The witness falls silent. A truth sleeps in the archives, and no one will come to read it.",
                        "kwRev": "silence — file lost"
                    },
                    "oeil": {
                        "name": "The Eye",
                        "up": "Knowing, and no longer being able to look away. You will be given an answer; it will come at a price.",
                        "kwUp": "knowledge, confession… surveillance?",
                        "rev": "What you refuse to see is already watching you. A muffled secret, a question no one asks: ignorance still protects you, for now.",
                        "kwRev": "denial — secret — who watches whom?"
                    },
                    "spirale": {
                        "name": "The Spiral",
                        "up": "Nothing is what it seems. One corridor too many, a memory that lies. Doubt what you think you know.",
                        "kwUp": "that door was NOT there yesterday",
                        "rev": "The geometry settles. A simple truth pierces the fog — if you dare believe it.",
                        "kwRev": "clarity, grounding"
                    },
                    "etranger": {
                        "name": "The Stranger",
                        "up": "An almost familiar face. Someone among you is not who they claim to be.",
                        "kwUp": "mask. imposture. who is it?",
                        "rev": "The mask slips. What was imitating a human gives itself away with a detail.",
                        "kwRev": "look at its hands."
                    },
                    "enseveli": {
                        "name": "The Buried",
                        "up": "The pressure builds, the air runs out. An obligation is slowly burying you.",
                        "kwUp": "suffocation. weight. depth.",
                        "rev": "A way out opens in the rock. Climb while there is still air.",
                        "kwRev": "breathe. climb."
                    },
                    "vaste": {
                        "name": "The Vast",
                        "up": "You are tiny before the immensity. Vertigo awaits whoever looks up.",
                        "kwUp": "vertigo. falling. excess.",
                        "rev": "The ground firms up under your feet. The horizon is a line again.",
                        "kwRev": "grounding — don’t look down"
                    },
                    "solitaire": {
                        "name": "The Lonely",
                        "up": "You are alone, even among others. Fog rises between you and the people who matter.",
                        "kwUp": "isolation. call someone.",
                        "rev": "A hand held out in the fog. Someone is still looking for you; answer them.",
                        "kwRev": "answer them."
                    },
                    "tenebres": {
                        "name": "The Dark",
                        "up": "What hides in the dark can see you perfectly well. Don’t turn off the lamp.",
                        "kwUp": "darkness. blindness. presence.",
                        "rev": "A glimmer breaks through. What was hidden lets itself be seen, for a moment.",
                        "kwRev": "keep a lamp lit"
                    },
                    "traque": {
                        "name": "The Hunt",
                        "up": "Something has caught your scent. Running will only make the chase more beautiful.",
                        "kwUp": "pursuit. prey. instinct.",
                        "rev": "The hunter loses your trail — or you become the hunter.",
                        "kwRev": "turn the tables?"
                    },
                    "carnage": {
                        "name": "The Slaughter",
                        "up": "Violence is near, brutal, senseless. Someone will bleed.",
                        "kwUp": "violence. war. blood.",
                        "rev": "The blade stays sheathed. Anger rumbles but does not strike yet.",
                        "kwRev": "defuse. fast."
                    },
                    "chair": {
                        "name": "The Flesh",
                        "up": "The body is only matter, and matter can be worked. Someone is looking at you the way one looks at a cut of meat.",
                        "kwUp": "body. appetite. transformation.",
                        "rev": "The body resists. You are more than a piece of flesh.",
                        "kwRev": "stay whole"
                    },
                    "corruption": {
                        "name": "The Corruption",
                        "up": "Something is slowly rotting, from the inside. A bond of love becomes a bond of dependence.",
                        "kwUp": "contagion. hive. hold.",
                        "rev": "The rot is contained. Cut away what is infected while there is still time.",
                        "kwRev": "cleanse. burn?"
                    },
                    "desolation": {
                        "name": "The Desolation",
                        "up": "Everything you cherish can burn. Loss is the offering demanded of you.",
                        "kwUp": "loss. fire. pain.",
                        "rev": "The embers die out. What was meant to burn is spared, this time.",
                        "kwRev": "spared — for now"
                    },
                    "toile": {
                        "name": "The Web",
                        "up": "An invisible hand wove this path. Someone led you here — and you thanked them.",
                        "kwUp": "manipulation. debt. who pulls the thread?",
                        "rev": "A thread snaps. You glimpse the weave: whoever pulls the strings can be defied, for a while.",
                        "kwRev": "hold broken — at last"
                    },
                    "fin": {
                        "name": "The End",
                        "up": "Everything ends. It isn’t a threat: it’s a promise, and it will be kept.",
                        "kwUp": "inevitable. don’t panic.",
                        "rev": "A reprieve. The end steps back, but it has written down your name.",
                        "kwRev": "reprieve — for how long?"
                    },
                    "extinction": {
                        "name": "The Extinction",
                        "up": "A world without you is being prepared. What is coming will leave no one to remember it.",
                        "kwUp": "end of the world? a new fear.",
                        "rev": "The future hesitates. Nothing is written yet, not even by the Archivist.",
                        "kwRev": "does it really exist?"
                    },
                    "deposition": {
                        "name": "The Statement",
                        "up": "A story asks to be told. Someone will come to give a statement, and their words will come at a price.",
                        "kwUp": "testimony. account. it’s recording.",
                        "rev": "The tape stops. What isn’t told stays in the shadows.",
                        "kwRev": "switch off the recorder"
                    }
                }
            }
        },
